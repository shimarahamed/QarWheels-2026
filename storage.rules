rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // The current admin record, not a possibly stale ID-token claim, grants access.
    function isAdmin() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/roles_admin/$(request.auth.uid));
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // 10MB cap and image-only content type on every upload path below —
    // without this, any authenticated caller could park arbitrarily large
    // or arbitrarily typed (e.g. executable) blobs in the bucket the app
    // pays to store and serve.
    function isReasonableImageUpload() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Mirrors src/lib/auth/qw-claims.ts's isBusinessMember — the uploader's
    // own qw claim carries their businessId directly, no Firestore lookup
    // needed (Storage rules can read custom claims off the token for free).
    function isBusinessMember(businessId) {
      return isSignedIn() && 'qw' in request.auth.token && request.auth.token.qw.b == businessId;
    }

    function canManageKyc(businessId) {
      return isBusinessMember(businessId)
        && request.auth.token.qw.r in ['business_owner', 'vendor_admin'];
    }

    // ─── KYC documents ────────────────────────────────────────────────────────
    // Uploaded by mobile/app/vendor/kyc.tsx to kyc/{businessId}/doc_*.{ext}.
    // Only a member of that business (during submission) and admins (during
    // review) may read or write — no public access, since these are
    // compliance documents.
    match /kyc/{businessId}/{fileName} {
      allow read: if canManageKyc(businessId) || isAdmin();
      // Business members upload their own docs (bounded size/type); admins
      // never need to write here — review is read-only.
      allow write: if canManageKyc(businessId)
        && (request.resource.size < 20 * 1024 * 1024)
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }

    // ─── Damage-report photos ──────────────────────────────────────────────────
    // Uploaded by mobile/app/damage-upload.tsx to damage/{uid}/photo_*.{ext} —
    // a customer's own vehicle-damage evidence. Owner-only; no business/admin
    // access needed since these aren't reviewed the way KYC is (yet).
    match /damage/{uid}/{fileName} {
      allow read, delete: if isOwner(uid);
      allow write: if isOwner(uid) && isReasonableImageUpload();
    }

    // ─── Profile photos ─────────────────────────────────────────────────────────
    // Not currently uploaded by either client (no callsite exists), but
    // declared so a future feature fails safe under the same owner-only
    // shape rather than silently hitting default-deny with a confusing error.
    match /profile-photos/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write, delete: if isOwner(uid) && isReasonableImageUpload();
    }
  }
}
