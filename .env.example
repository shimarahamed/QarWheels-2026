# ─── Firebase (client-side, NEXT_PUBLIC_ prefix required) ───────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ─── Firebase (server-side, Admin SDK — service account JSON as one line) ───
# Used by src/lib/firebase-admin.ts for privileged writes (e.g. KYC review)
# that must never be reachable from a client-side Firestore write.
FIREBASE_SERVICE_ACCOUNT_KEY=

# ─── AI ─────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:9002

# Rate limiting (optional in dev, recommended in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Email (staff invites, etc.) ─────────────────────────────────────────────
# No provider wired in yet — see src/lib/email.ts. Until set, invite emails
# are logged, not sent; the invite link is still valid and can be shared
# manually from the staff page.
EMAIL_PROVIDER_API_KEY=

# ─── Scheduled jobs ───────────────────────────────────────────────────────────
# Shared secret checked by /api/bookings/expire so it isn't publicly triggerable.
CRON_SECRET=
