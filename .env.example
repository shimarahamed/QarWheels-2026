# First-release API for booking, vendor operations, and invoices. Native builds
# need a device-reachable HTTPS URL. Local web development can use localhost.
# This is the Firebase App Hosting Next.js web/backend HTTPS origin, without /api.
# Do not use the static business website or a Firestore service endpoint.
# release:check loads .env unless --env-file is provided; EAS/process env wins.
EXPO_PUBLIC_API_BASE_URL=

# Optional legacy integrations; unavailable first-release screens remain gated.
EXPO_PUBLIC_BACKEND_URL=

# ─── Payments ────────────────────────────────────────────────────────────────
# Online cards are not offered in the pay-at-garage first release. Do not set
# this key as a substitute for a server-owned payment and receipt lifecycle.
EXPO_PUBLIC_TAP_PUBLIC_KEY=

# ─── Crash reporting ─────────────────────────────────────────────────────────
# Sentry DSN. When empty, initObservability() and every track()/reportError()
# call becomes a no-op — safe for local dev, but it means production crashes go
# unrecorded. Required by release:check; set this before shipping.
EXPO_PUBLIC_SENTRY_DSN=

# ─── Firebase ────────────────────────────────────────────────────────────────
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In (expo-auth-session). This is the "Web client" OAuth client ID
# from the Firebase console (Authentication > Sign-in method > Google), used
# as the `clientId` for every platform — required for Google sign-in on the
# welcome/login screens to work; without it the Google button is disabled.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Native Google Maps key: restrict it to the app bundle/package and signing identity.
# Set in the native build environment; this is public configuration, not a server secret.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
