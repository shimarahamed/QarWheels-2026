# Backend API used by AI mechanic, support, coupons, damage analysis, and
# booking confirmation. Read by 18 screens. When unset, those screens fall back
# to a local demo mode instead of live data — set this for production builds.
EXPO_PUBLIC_BACKEND_URL=https://api.qarwheel.qa

# Legacy base URL, read only by lib/api.ts.
EXPO_PUBLIC_API_BASE_URL=http://localhost:9002

# ─── Payments ────────────────────────────────────────────────────────────────
# Tap Payments publishable key. Cards are tokenised on-device against Tap and
# never sent to our servers raw. Card entry fails without this.
# Use the pk_test_* key outside production.
EXPO_PUBLIC_TAP_PUBLIC_KEY=

# ─── Crash reporting ─────────────────────────────────────────────────────────
# Sentry DSN. When empty, initObservability() and every track()/reportError()
# call becomes a no-op — safe for local dev, but it means production crashes go
# unrecorded. Set this before shipping.
EXPO_PUBLIC_SENTRY_DSN=

# ─── Firebase ────────────────────────────────────────────────────────────────
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In (expo-auth-session). This is the "Web client" OAuth client ID
# from the Firebase console (Authentication > Sign-in method > Google), used
# as the `clientId` for every platform — required for Google sign-in on the
# welcome/login screens to work; without it the Google button is disabled.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Native Google Maps key: restrict it to the app bundle/package and signing identity.
# Set in the native build environment; this is public configuration, not a server secret.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
