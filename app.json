{
  "expo": {
    "name": "QarWheel",
    "slug": "qarwheel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "qarwheel",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qarwheel.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "QarWheel uses your location to show nearby garages and service providers.",
        "NSPhotoLibraryUsageDescription": "QarWheel lets you attach service invoices and car photos to requests.",
        "NSCameraUsageDescription": "QarWheel uses the camera to scan your VIN and photograph vehicle damage.",
        "NSUserNotificationsUsageDescription": "QarWheel sends booking updates and maintenance reminders.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.qarwheel.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2563EB"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      "expo-updates",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "ar"],
            "android": ["en", "ar"]
          }
        }
      ],
      "@sentry/react-native"
    ],
    "locales": {
      "ar": "./locales/ar.json"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "82f5e090-8453-46e6-bbf0-e30fe9f13910"
      }
    }
  }
}
