{
  "expo": {
    "name": "QarWheel",
    "slug": "qarwheel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "qarwheel",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qarwheel.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "QarWheel uses your location to show nearby garages and service providers.",
        "NSPhotoLibraryUsageDescription": "QarWheel lets you attach service invoices and car photos to requests.",
        "NSCameraUsageDescription": "QarWheel uses the camera to scan your VIN and photograph vehicle damage.",
        "NSBluetoothAlwaysUsageDescription": "QarWheel uses Bluetooth to connect to your OBD-II diagnostics adapter.",
        "NSFaceIDUsageDescription": "Allow QarWheel to use Face ID to unlock your account.",
        "NSUserNotificationsUsageDescription": "QarWheel sends booking updates and maintenance reminders.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.qarwheel.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "CAMERA",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2563EB"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      ["expo-local-authentication", { "faceIDPermission": "Allow QarWheel to use Face ID to unlock your account." }],
      "expo-notifications",
      "react-native-maps",
      "expo-font",
      "expo-web-browser",
      "expo-updates",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "ar"
            ],
            "android": [
              "en",
              "ar"
            ]
          }
        }
      ],
      "@sentry/react-native",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar",
      ["react-native-ble-plx", { "isBackgroundEnabled": false, "modes": [] }]
    ],
    "locales": {
      "ar": "./locales/ar.json"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "82f5e090-8453-46e6-bbf0-e30fe9f13910"
      }
    }
  }
}
