{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 9002",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --max-warnings=0",
    "lint:all": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "mobile:start": "npm --prefix mobile start",
    "mobile:android": "npm --prefix mobile run android",
    "mobile:ios": "npm --prefix mobile run ios",
    "mobile:typecheck": "npm --prefix mobile run typecheck",
    "mobile:export:web": "npm --prefix mobile run export:web",
    "check:all": "npm run check:systems && npm run tokens:check && npm run test:tooling && npm run check:web && npm run check:website && npm run mobile:verify",
    "test:rules": "firebase emulators:exec --project demo-no-project --only firestore,storage \"vitest run tests/rules tests/storage\"",
    "seed:reset": "node --env-file=.env.local scripts/reset-firestore.mjs",
    "seed:demo": "node --env-file=.env.local scripts/seed-demo.mjs",
    "admin:bootstrap": "node --env-file=.env.local scripts/bootstrap-admin.mjs",
    "tokens:build": "node scripts/build-tokens.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "check:systems": "node scripts/check-systems.mjs",
    "check:web": "npm run lint && npm run typecheck && npm test && npm run build",
    "check:website": "python QarWheel-Unified-Website/validate.py && node --check QarWheel-Unified-Website/source/assets/unified.js && node --check QarWheel-Unified-Website/source/assets/theme-init.js",
    "test:tooling": "node --test tests/tooling/*.test.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "mobile:verify": "npm --prefix mobile run verify",
    "mobile:release:check": "npm --prefix mobile run release:check",
    "release:check": "node scripts/check-release.mjs",
    "website:build": "python QarWheel-Unified-Website/build.py --package"
  },
  "dependencies": {
    "@genkit-ai/google-genai": "^1.43.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dotenv": "^16.5.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^11.9.1",
    "firebase-admin": "^14.3.0",
    "genkit": "^1.43.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "next": "^15.5.28",
    "react": "19.2.3",
    "react-day-picker": "^9.11.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20",
    "@types/react": "~19.2.10",
    "@types/react-dom": "^19.2.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "firebase-tools": "^15.22.4",
    "genkit-cli": "^1.44.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.4",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  },
  "overrides": {
    "shell-quote": "^1.11.0",
    "handlebars": "^4.7.10",
    "websocket-driver": "^0.7.5",
    "@grpc/grpc-js": "^1.14.6",
    "protobufjs": "^7.6.3",
    "postcss": "$postcss",
    "qs": "^6.17.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
